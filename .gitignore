# Secrets générés localement — jamais commités (seuls les *.enc.yaml SOPS le sont)
secrets/*
!secrets/README.md
!secrets/*.enc.yaml
.env

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node
node_modules/
dist/

# Données ML / runtime
ml/data/*.parquet
ml/data/*.csv
!ml/data/.gitkeep

# Labels générés par le kit d'attaque (à recopier sur l'hôte, pas à commiter)
attack/data/*.csv
!attack/data/.gitkeep

# Office temp files
~$*

# Watchdog du labo
infra/.lab_paused
infra/watchdog.log
